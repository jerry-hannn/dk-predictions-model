# DraftKings Predictions (DKeX) Web Application Configuration

# Server & Remote Access
HOST=0.0.0.0
PORT=8000

# Optional passcode to protect remote deployments (leave empty for local open access)
APP_PASSCODE=

# Optional persistent directory for cloud volumes (e.g. /data on Docker, Render, Railway, Fly.io)
DATA_DIR=

# Portfolio & Risk Defaults (also editable directly in the Web UI)
BANKROLL=1000.0
DEFAULT_FEE_DOLLARS=0.015
KELLY_FRACTION=0.25
MAX_SINGLE_BET_PCT=0.04
MAX_SAME_GAME_PCT=0.06
MIN_WIN_PROB=0.60
MIN_NET_EDGE=0.025

# Traditional Sportsbooks Mode (DraftKings & FanDuel, exclusive toggle editable in Web UI)
TRADITIONAL_SPORTSBOOKS_ENABLED=false
DK_BANKROLL=
FD_BANKROLL=
ARB_STAKE_ROUNDING=1.0
MIN_ARB_ROI=0.005
MIN_SB_EV_EDGE=0.02
INCLUDE_DKEX_CROSS_ARB=true

# Optional: Free API key from https://the-odds-api.com for automated multi-book sharp consensus
THE_ODDS_API_KEY=

# Explicit path overrides (optional when DATA_DIR is unset)
DB_PATH=data/dk_model.sqlite3
MODELS_DIR=models
